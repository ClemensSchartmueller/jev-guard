{
  "mode": "enforcing",
  "typesafe_api_key": "",
  "timeout_ms": 1500,
  "model": "jev-latest",
  "audit_log_path": ".jevguard.log",
  "sensitive_files": [
    ".env",
    ".env.*",
    "*.pem",
    "*.key",
    "id_rsa",
    "id_ed25519",
    "credentials.json"
  ],
  "trusted_commands": [
    "git status",
    "git diff",
    "git log"
  ]
}
