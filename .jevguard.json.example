{
  "mode": "enforcing",
  "typesafe_api_key": "",
  "timeout_ms": 1500,
  "model": "jev-latest",
  "fastpath_enabled": true,
  "context_awareness_enabled": true,
  "audit_log_path": ".jevguard.log",
  "sensitive_files": [
    ".env",
    "*.pem",
    "id_rsa"
  ],
  "trusted_commands": [
    "git status",
    "git log"
  ]
}
